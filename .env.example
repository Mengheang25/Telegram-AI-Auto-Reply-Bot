# ============================================================
# TELEGRAM BOT CONFIGURATION
# ============================================================

# Telegram Bot Token (យកពី @BotFather)
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# OpenRouter API Key (យកពី https://openrouter.ai/keys)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# Admin Telegram ID (សម្រាប់ទទួលការជូនដំណឹងពេលមានអ្នកប្រើថ្មី)
# អាចរក User ID បានតាមរយៈ @userinfobot
ADMIN_ID=YOUR_ADMIN_TELEGRAM_ID_HERE

# ============================================================
# OPTIONAL CONFIGURATIONS
# ============================================================

# Model (ប្រើ default ឬប្តូរតាមចិត្ត)
MODEL=deepseek/deepseek-v4-flash

# Database file name
DB_FILE=users.db

# Maximum conversation history
MAX_HISTORY=10

# Maximum tokens for AI response
MAX_TOKENS=4000